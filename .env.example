# Server Configuration
Port=8000
NODE_ENV=development

# Database Configuration
Connect_URI=mongodb://localhost:27017/djsnss-web
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/djsnss-web

# Redis Configuration
REDIS_URL=redis://localhost:6379
# For Redis Cloud: redis://username:password@hostname:port

# JWT Configuration
SecretKey=your-super-secret-jwt-key-here-make-it-long-and-complex

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Nodemailer Configuration (Gmail SMTP)
user=your-gmail-email@gmail.com
pass=your-gmail-app-password